[Unit]
Description=squid5060 Inkling-2-Mini 8 GB Inference Engine & OpenAI API Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/squid5060
Environment="LD_LIBRARY_PATH=/opt/cuda/lib64:/usr/local/cuda/lib64"
# Optional: require Authorization: Bearer <key> (or pass --api-key-file /path/to/key)
# Environment="SQUID_API_KEY=your-secret-key"

# Default 8 GB RTX 5060 v3.8.0 profile: native NVFP4 + Hybrid AVX-VNNI CPU+GPU MoE +
# Blackwell TC MoE + lazy 32K->256K Q4 global / FP8 local SWA KV (full 1,470 hot experts at 32K) +
# 5-way {1, 2, 3, 4, 8} adaptive DSpark MTP + sampled-safe prompt-copy + 8-slot rolling prefix cache +
# live SSE tool_calls streaming + auto idle-sleep (300s -> 0.22 GiB VRAM) + 4 parked sessions + 0-VRAM vision.
ExecStart=/opt/squid5060/zig-out/bin/squid5060 serve /opt/models/inkling-2-mini \
    --host 127.0.0.1 \
    --port 8000 \
    --mode nvfp4 \
    --kv q4 \
    --ctx 262144 \
    --mtp 7 \
    --spec-threshold 0.90 \
    --idle-sleep 300 \
    --slot-keep 4 \
    --temp 1.0 \
    --top-p 0.95

Restart=on-failure
RestartSec=3
TimeoutStopSec=15
LimitNOFILE=65536

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
