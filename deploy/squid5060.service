[Unit]
Description=squid5060 Inkling-2-Mini 8 GB Inference Engine & OpenAI API Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/squid5060
Environment="LD_LIBRARY_PATH=/opt/cuda/lib64:/usr/local/cuda/lib64"
# Optional: require Authorization: Bearer <key> (or pass --api-key-file /path/to/key)
# Environment="SQUID_API_KEY=your-secret-key"

# Default 8 GB RTX 5060 v2 profile: native NVFP4 + Q4 global / FP8 local SWA KV +
# tail-aliased B=1024 TC prefill + unified VRAM expert cache (~7.47 GiB peak VRAM) +
# 4-way {1, 2, 4, 8} adaptive DSpark MTP + Hybrid O(1) Prompt-Lookup (--spec-threshold 0.90).
# Pass --mtp 0 to disable speculative decoding, or --ctx 65536 / 131072 for deeper context.
ExecStart=/opt/squid5060/zig-out/bin/squid5060 serve /opt/models/inkling-2-mini \
    --host 127.0.0.1 \
    --port 8000 \
    --mode nvfp4 \
    --kv q4 \
    --ctx 32768 \
    --mtp 7 \
    --spec-threshold 0.90 \
    --temp 1.0 \
    --top-p 0.95

Restart=on-failure
RestartSec=3
TimeoutStopSec=15
LimitNOFILE=65536

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
